# Copy this file to .env and fill in only what you need.
# Never commit your real .env file.

# AI providers (all optional). The scanner works fine without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Which AI provider and model to use when AI is turned on.
# Provider: openai, anthropic, xai, openrouter, or groq
AEVRIN_AI_PROVIDER=
AEVRIN_AI_MODEL=

# Turn AI review on (true) or off (false). Default: off.
AEVRIN_AI_ENABLED=false

# Sandbox mode: auto, docker, or process.
AEVRIN_SANDBOX_MODE=auto

# Allow servers to run on this machine with the process sandbox, without asking.
# Only set this when the scanner itself is already inside a container or VM.
AEVRIN_SANDBOX_ALLOW_HOST=false

# Log level: DEBUG, INFO, WARNING, ERROR
AEVRIN_LOG_LEVEL=WARNING

# Folder for report files.
AEVRIN_OUTPUT_DIR=
